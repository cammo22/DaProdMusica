uniform float uSpeed;
void main(){vec2 p=centered();float t=uTime*uSpeed;vec2 q=p;float horizon=q.y+.15;vec3 c=vec3(.008,.018,.06);for(int i=0;i<24;i++){float f=float(i);float x=(f-12.)*.12;float height=.2+hash11(f+uSeed)*.8;float w=.045;float rect=step(abs(q.x-x),w)*step(q.y,-.05+height)*step(-.4,q.y);float windows=step(.65,fract(q.y*25.+f*.3))*step(.6,fract(q.x*80.));c+=rect*vec3(.03,.12,.18)+rect*windows*vec3(.05,.6,1.)*(.2+band(f/24.));}float road=pow(max(0.,1.-abs(sin(q.x/(abs(horizon)+.1)*5.))*12.),2.)*step(horizon,0.);c+=road*vec3(.2,.5,1.);c+=exp(-length(q-vec2(0.,.4))*5.)*vec3(.15,.02,.3);gl_FragColor=vec4(max(c,vec3(0.)),1.);}
